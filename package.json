{
  "name": "pliego",
  "version": "1.7.1",
  "description": "Biblioteca documental visual, r\u00e1pida y local construida con Tauri.",
  "private": true,
  "license": "MIT",
  "homepage": "https://github.com/RaulLzn/pliego#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RaulLzn/pliego.git"
  },
  "bugs": {
    "url": "https://github.com/RaulLzn/pliego/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test:reading-layout": "node --test tests/reading-layout.test.js",
    "test:annotations": "node --test src/annotations.test.js",
    "preview": "vite preview",
    "check": "npm run test:unit && npm run build && cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "check:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test:unit": "node --test tests/*.test.js src/annotations.test.js"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.0",
    "vite": "^8.3.1"
  },
  "dependencies": {
    "@fontsource/lato": "^5.3.0",
    "@fontsource/raleway": "^5.3.0",
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-dialog": "^2.8.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.0",
    "dompurify": "^3.4.16",
    "highlight.js": "^11.12.0",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "mermaid": "^12.0.0",
    "papaparse": "^5.7.0",
    "pdfjs-dist": "^6.3.289",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  }
}
