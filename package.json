{
  "name": "pliego",
  "version": "1.4.3",
  "description": "Biblioteca documental visual, rápida y local construida con Tauri.",
  "private": true,
  "license": "MIT",
  "homepage": "https://github.com/RaulLzn/pliego#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RaulLzn/pliego.git"
  },
  "bugs": {
    "url": "https://github.com/RaulLzn/pliego/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "npm run build && cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "check:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.5",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "dompurify": "^3.4.15",
    "highlight.js": "^11.12.0",
    "jszip": "^3.10.2",
    "mammoth": "^1.12.3",
    "mermaid": "^12.0.0",
    "papaparse": "^5.7.0",
    "pdfjs-dist": "^6.3.289",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  }
}
