{
  "name": "pliego",
  "version": "1.4.0",
  "description": "Biblioteca documental visual, rápida y local construida con Tauri.",
  "private": true,
  "license": "MIT",
  "homepage": "https://github.com/RaulLzn/pliego#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RaulLzn/pliego.git"
  },
  "bugs": {
    "url": "https://github.com/RaulLzn/pliego/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "npm run build && cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "check:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.0",
    "vite": "^8.1.5"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "dompurify": "^3.4.13",
    "highlight.js": "^11.11.1",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "mermaid": "^11.16.1",
    "papaparse": "^5.5.4",
    "pdfjs-dist": "^6.2.108",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  }
}
