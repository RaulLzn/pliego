{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Pliego",
  "version": "1.4.1",
  "identifier": "com.raul.pliego",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev -- --host 0.0.0.0 --port 1420",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Pliego",
        "width": 1360,
        "height": 900,
        "minWidth": 960,
        "minHeight": 680,
        "resizable": true,
        "decorations": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self'; img-src 'self' data: blob:; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; worker-src 'self' blob:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "RaulLzn",
    "copyright": "Copyright © 2026 RaulLzn",
    "license": "MIT",
    "homepage": "https://github.com/RaulLzn/pliego",
    "shortDescription": "Biblioteca documental visual, rápida y local",
    "longDescription": "Pliego organiza, visualiza, conecta y edita documentos con asistencia local de IA.",
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown",
          "mkd"
        ],
        "mimeType": "text/markdown",
        "name": "Markdown",
        "role": "Editor"
      },
      {
        "ext": [
          "txt"
        ],
        "mimeType": "text/plain",
        "name": "Texto plano",
        "role": "Editor"
      },
      {
        "ext": ["pdf"],
        "mimeType": "application/pdf",
        "name": "PDF",
        "role": "Viewer"
      },
      {
        "ext": ["csv"],
        "mimeType": "text/csv",
        "name": "CSV",
        "role": "Editor"
      },
      {
        "ext": ["tsv"],
        "mimeType": "text/tab-separated-values",
        "name": "TSV",
        "role": "Editor"
      },
      {
        "ext": ["docx"],
        "mimeType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "name": "Documento Word",
        "role": "Viewer"
      },
      {
        "ext": ["epub"],
        "mimeType": "application/epub+zip",
        "name": "EPUB",
        "role": "Viewer"
      },
      {
        "ext": ["mmd", "mermaid"],
        "mimeType": "text/plain",
        "name": "Mermaid",
        "role": "Editor"
      },
      {
        "ext": ["png"],
        "mimeType": "image/png",
        "name": "Imagen PNG",
        "role": "Viewer"
      },
      {
        "ext": ["jpg", "jpeg"],
        "mimeType": "image/jpeg",
        "name": "Imagen JPEG",
        "role": "Viewer"
      },
      {
        "ext": ["gif"],
        "mimeType": "image/gif",
        "name": "Imagen GIF",
        "role": "Viewer"
      },
      {
        "ext": ["webp"],
        "mimeType": "image/webp",
        "name": "Imagen WebP",
        "role": "Viewer"
      },
      {
        "ext": ["svg"],
        "mimeType": "image/svg+xml",
        "name": "Imagen SVG",
        "role": "Viewer"
      },
      {
        "ext": ["bmp"],
        "mimeType": "image/bmp",
        "name": "Imagen BMP",
        "role": "Viewer"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": true
    },
    "linux": {
      "deb": {
        "desktopTemplate": "linux/pliego.desktop.hbs"
      },
      "rpm": {
        "desktopTemplate": "linux/pliego.desktop.hbs"
      }
    }
  }
}
